{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "K-12 Diagnostic Question",
  "description": "中国K-12知识图谱 - 诊断题定义",
  "type": "object",
  "required": ["id", "topicId", "question", "answer", "type"],
  "properties": {
    "id": {
      "type": "string",
      "description": "题目唯一ID"
    },
    "topicId": {
      "type": "string",
      "description": "对应的知识点ID"
    },
    "question": {
      "type": "string",
      "description": "题目内容"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "text": { "type": "string" }
        }
      },
      "description": "选择题选项（非选择题为空数组）"
    },
    "answer": {
      "type": "string",
      "description": "正确答案"
    },
    "type": {
      "type": "string",
      "enum": ["choice", "fill", "short-answer"],
      "description": "题目类型"
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"],
      "description": "难度级别"
    },
    "explanation": {
      "type": "string",
      "description": "答案解析"
    }
  },
  "additionalProperties": false
}
