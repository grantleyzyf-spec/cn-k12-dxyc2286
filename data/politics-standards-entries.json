[
 {
  "id": "ddf-2022:1.RX.01",
  "stage": "义教",
  "segment": 1,
  "theme": "入学教育",
  "seq": 1,
  "line": 4,
  "quote": "上学了，感受自己身份的变化，初步了解学校的环境。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.RX.02",
  "stage": "义教",
  "segment": 1,
  "theme": "入学教育",
  "seq": 2,
  "line": 5,
  "quote": "知道课堂常规，学会整理书包和准备学习用品。学会自己的事情自己做。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.RX.03",
  "stage": "义教",
  "segment": 1,
  "theme": "入学教育",
  "seq": 3,
  "line": 6,
  "quote": "能制订出切实可行的目标，认真完成自己承担的任务。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.RX.04",
  "stage": "义教",
  "segment": 1,
  "theme": "入学教育",
  "seq": 4,
  "line": 7,
  "quote": "合理制订学习和作息计划，生活有规律。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.RX.05",
  "stage": "义教",
  "segment": 1,
  "theme": "入学教育",
  "seq": 5,
  "line": 8,
  "quote": "尊敬师长，对师长有礼貌。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.RX.06",
  "stage": "义教",
  "segment": 1,
  "theme": "入学教育",
  "seq": 6,
  "line": 9,
  "quote": "喜欢和同学、老师交往，高高兴兴地学，快快乐乐地玩。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.RX.07",
  "stage": "义教",
  "segment": 1,
  "theme": "入学教育",
  "seq": 7,
  "line": 10,
  "quote": "融入集体生活，爱护班级荣誉。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.DD.01",
  "stage": "义教",
  "segment": 1,
  "theme": "道德教育",
  "seq": 1,
  "line": 11,
  "quote": "乐于探究，在学习与生活中遇到问题时能够想办法解决，提高动脑动手能力。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.DD.02",
  "stage": "义教",
  "segment": 1,
  "theme": "道德教育",
  "seq": 2,
  "line": 12,
  "quote": "做事认真，有始有终，不拖拉。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.DD.03",
  "stage": "义教",
  "segment": 1,
  "theme": "道德教育",
  "seq": 3,
  "line": 13,
  "quote": "学习分辨是非，做了错事勇于承认和改正，不撒谎。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.DD.04",
  "stage": "义教",
  "segment": 1,
  "theme": "道德教育",
  "seq": 4,
  "line": 14,
  "quote": "能看到自己的成长和进步，学会正确对待自己的学习成绩。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.DD.05",
  "stage": "义教",
  "segment": 1,
  "theme": "道德教育",
  "seq": 5,
  "line": 15,
  "quote": "欣赏他人的优点，并以此激励自己不断进步。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.DD.06",
  "stage": "义教",
  "segment": 1,
  "theme": "道德教育",
  "seq": 6,
  "line": 16,
  "quote": "关心他人，乐于与同伴合作、分享。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.DD.07",
  "stage": "义教",
  "segment": 1,
  "theme": "道德教育",
  "seq": 7,
  "line": 17,
  "quote": "在遇到困难和危险时懂得求助，懂得感恩，乐于助人。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.DD.08",
  "stage": "义教",
  "segment": 1,
  "theme": "道德教育",
  "seq": 8,
  "line": 18,
  "quote": "亲近自然，感受自然的美，保护动物，爱护一草一木，保护自然环境。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.DD.09",
  "stage": "义教",
  "segment": 1,
  "theme": "道德教育",
  "seq": 9,
  "line": 19,
  "quote": "了解家乡的风景名胜和主要物产，关注家乡的发展变化。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.DD.10",
  "stage": "义教",
  "segment": 1,
  "theme": "道德教育",
  "seq": 10,
  "line": 20,
  "quote": "知道社会主义核心价值观的概念，能记住社会主义核心价值观。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.SM.01",
  "stage": "义教",
  "segment": 1,
  "theme": "生命安全与健康教育",
  "seq": 1,
  "line": 21,
  "quote": "认识道路交通标志，掌握报警的基本常识。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.SM.02",
  "stage": "义教",
  "segment": 1,
  "theme": "生命安全与健康教育",
  "seq": 2,
  "line": 22,
  "quote": "能够识别公共环境中的安全标识，安全有序使用和爱护公共设施。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.SM.03",
  "stage": "义教",
  "segment": 1,
  "theme": "生命安全与健康教育",
  "seq": 3,
  "line": 23,
  "quote": "学会发现和识别身边的安全隐患，保护自己。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.SM.04",
  "stage": "义教",
  "segment": 1,
  "theme": "生命安全与健康教育",
  "seq": 4,
  "line": 24,
  "quote": "学会用适当的方式化解自己的消极情绪。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.SM.05",
  "stage": "义教",
  "segment": 1,
  "theme": "生命安全与健康教育",
  "seq": 5,
  "line": 25,
  "quote": "养成良好的饮食和个人卫生习惯。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.SM.06",
  "stage": "义教",
  "segment": 1,
  "theme": "生命安全与健康教育",
  "seq": 6,
  "line": 26,
  "quote": "爱护家庭、学校和公共环境卫生。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.FZ.01",
  "stage": "义教",
  "segment": 1,
  "theme": "法治教育",
  "seq": 1,
  "line": 27,
  "quote": "知道学校生活有规则，树立规则意识。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.FZ.02",
  "stage": "义教",
  "segment": 1,
  "theme": "法治教育",
  "seq": 2,
  "line": 28,
  "quote": "讲信用，守约定，承诺的事情要做到。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.FZ.03",
  "stage": "义教",
  "segment": 1,
  "theme": "法治教育",
  "seq": 3,
  "line": 29,
  "quote": "懂得爱护国旗、国徽，知道法律不允许毁损、涂划国旗、国徽。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.CT.01",
  "stage": "义教",
  "segment": 1,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 1,
  "line": 30,
  "quote": "了解中华民族勤俭节约的传统美德，养成不浪费的习惯。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.CT.02",
  "stage": "义教",
  "segment": 1,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 2,
  "line": 31,
  "quote": "尊敬父母长辈，体贴家人，承担力所能及的家务劳动。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.CT.03",
  "stage": "义教",
  "segment": 1,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 3,
  "line": 32,
  "quote": "感受中华民族自强不息的传统美德。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.CT.04",
  "stage": "义教",
  "segment": 1,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 4,
  "line": 33,
  "quote": "认识国旗、国徽，学唱国歌，知道自己是中国人。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.CT.05",
  "stage": "义教",
  "segment": 1,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 5,
  "line": 34,
  "quote": "知道我们国家的全称是中华人民共和国，认识中国版图，了解全民国家安全教育日。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.CT.06",
  "stage": "义教",
  "segment": 1,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 6,
  "line": 35,
  "quote": "知道我国是一个统一的多民族国家，有56 个民族。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.CT.07",
  "stage": "义教",
  "segment": 1,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 7,
  "line": 36,
  "quote": "认识党旗，热爱中国共产党，拥护中国共产党的领导，感受党的百年奋斗取得的重大成就。了解党和国家主要领导人。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.CT.08",
  "stage": "义教",
  "segment": 1,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 8,
  "line": 37,
  "quote": "了解中国少年先锋队是中国少年儿童的群团组织，是少年儿童学习中国特色社会主义和共产主义的学校，是建设社会主义和共产主义的预备队。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.CT.09",
  "stage": "义教",
  "segment": 1,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 9,
  "line": 38,
  "quote": "了解在民族独立、人民解放斗争中涌现出的革命领袖和英雄人物。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:1.CT.10",
  "stage": "义教",
  "segment": 1,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 10,
  "line": 39,
  "quote": "了解当代社会生活中的英雄模范人物，见贤思齐，学习他们高尚的道德情操。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.DD.01",
  "stage": "义教",
  "segment": 2,
  "theme": "道德教育",
  "seq": 1,
  "line": 40,
  "quote": "关心家庭生活，主动分担家务劳动。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.DD.02",
  "stage": "义教",
  "segment": 2,
  "theme": "道德教育",
  "seq": 2,
  "line": 41,
  "quote": "学习合理消费、勤俭节约的途径和方法，明白劳动创造财富的道理。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.DD.03",
  "stage": "义教",
  "segment": 2,
  "theme": "道德教育",
  "seq": 3,
  "line": 42,
  "quote": "学习和掌握日常生活中待人接物的基本礼仪。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.DD.04",
  "stage": "义教",
  "segment": 2,
  "theme": "道德教育",
  "seq": 4,
  "line": 43,
  "quote": "尊重老师，感受老师的辛劳；学会和同学平等相处，知道同学之间要相互尊重、友好交往。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.DD.05",
  "stage": "义教",
  "segment": 2,
  "theme": "道德教育",
  "seq": 5,
  "line": 44,
  "quote": "了解个体与集体的关系，关心集体，有互助意识，积极参加集体活动，维护集体荣誉。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.DD.06",
  "stage": "义教",
  "segment": 2,
  "theme": "道德教育",
  "seq": 6,
  "line": 45,
  "quote": "懂得邻里之间要和睦相处。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.DD.07",
  "stage": "义教",
  "segment": 2,
  "theme": "道德教育",
  "seq": 7,
  "line": 46,
  "quote": "尊重劳动者，懂得职业没有高低贵贱之分，感受并感激他们的劳动给人们生活带来的便利，珍惜他们的劳动成果。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.DD.08",
  "stage": "义教",
  "segment": 2,
  "theme": "道德教育",
  "seq": 8,
  "line": 47,
  "quote": "爱科学，崇尚科学精神。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.DD.09",
  "stage": "义教",
  "segment": 2,
  "theme": "道德教育",
  "seq": 9,
  "line": 48,
  "quote": "体验公共设施给人们生活带来的便利，形成爱护公共设施人人有责的意识。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.DD.10",
  "stage": "义教",
  "segment": 2,
  "theme": "道德教育",
  "seq": 10,
  "line": 49,
  "quote": "学习环境保护的基本常识，增强环境保护意识。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.DD.11",
  "stage": "义教",
  "segment": 2,
  "theme": "道德教育",
  "seq": 11,
  "line": 50,
  "quote": "正确运用网络和电子产品；学习基本的网络道德规范，做到文明上网。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.DD.12",
  "stage": "义教",
  "segment": 2,
  "theme": "道德教育",
  "seq": 12,
  "line": 51,
  "quote": "初步理解社会主义核心价值观的要求，并在日常生活和集体活动中践行社会主义核心价值观。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.SM.01",
  "stage": "义教",
  "segment": 2,
  "theme": "生命安全与健康教育",
  "seq": 1,
  "line": 52,
  "quote": "了解自己，学会悦纳自己；正确对待挫折和困难，增强抗挫折能力。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.SM.02",
  "stage": "义教",
  "segment": 2,
  "theme": "生命安全与健康教育",
  "seq": 2,
  "line": 53,
  "quote": "掌握良好的人际交往技能，学会倾听和表达，学会团结和包容，养成礼貌友好的交往品质，形成合群而独立的健康人格。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.SM.03",
  "stage": "义教",
  "segment": 2,
  "theme": "生命安全与健康教育",
  "seq": 3,
  "line": 54,
  "quote": "初步感受学习知识的乐趣，能够自主参与各种活动，养成自主学习的习惯；正确对待学习中的困难，学会化解消极情绪。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.SM.04",
  "stage": "义教",
  "segment": 2,
  "theme": "生命安全与健康教育",
  "seq": 4,
  "line": 55,
  "quote": "知道生命只有一次，理解生命的珍贵，懂得珍惜生命，呵护生命。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.SM.05",
  "stage": "义教",
  "segment": 2,
  "theme": "生命安全与健康教育",
  "seq": 5,
  "line": 56,
  "quote": "树立安全自律意识，学会自我保护技能，远离危险；知道保护隐私的重要性，能够识别陌生环境，谨慎与陌生人交往。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.FZ.01",
  "stage": "义教",
  "segment": 2,
  "theme": "法治教育",
  "seq": 1,
  "line": 57,
  "quote": "了解制定规则要遵循一定的程序，树立参与意识和规则意识。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.FZ.02",
  "stage": "义教",
  "segment": 2,
  "theme": "法治教育",
  "seq": 2,
  "line": 58,
  "quote": "知道法律能够保护我们的生活，了解道路交通、环境保护、消防安全等生活中常用的法律。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.FZ.03",
  "stage": "义教",
  "segment": 2,
  "theme": "法治教育",
  "seq": 3,
  "line": 59,
  "quote": "树立民主、平等观念，积极参与民主管理，在集体生活中平等待人。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.FZ.04",
  "stage": "义教",
  "segment": 2,
  "theme": "法治教育",
  "seq": 4,
  "line": 60,
  "quote": "初步了解国家统一和民族团结的重要性，树立维护国家统一和民族团结的意识。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.CT.01",
  "stage": "义教",
  "segment": 2,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 1,
  "line": 61,
  "quote": "感受父母长辈的养育之恩，以恰当的方式表达对他们的感激、尊敬和关心。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.CT.02",
  "stage": "义教",
  "segment": 2,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 2,
  "line": 62,
  "quote": "了解自己家庭的历史，知道弘扬优秀家风的意义，初步体会中国人的家庭观念。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.CT.03",
  "stage": "义教",
  "segment": 2,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 3,
  "line": 63,
  "quote": "理解中华民族传统美德，如仁爱、诚信、谦逊等。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.CT.04",
  "stage": "义教",
  "segment": 2,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 4,
  "line": 64,
  "quote": "知道我们辽阔的疆域是各民族共同开拓的，悠久的历史是各民族共同书写的，灿烂的文化是各民族共同创造的，伟大的精神是各民族共同培育的。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.CT.05",
  "stage": "义教",
  "segment": 2,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 5,
  "line": 65,
  "quote": "知道中华优秀传统文化的主要代表性成果，初步感受中华优秀传统文化的魅力。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.CT.06",
  "stage": "义教",
  "segment": 2,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 6,
  "line": 66,
  "quote": "了解革命英雄人物的故事，体会“没有共产党就没有新中国”。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.CT.07",
  "stage": "义教",
  "segment": 2,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 7,
  "line": 67,
  "quote": "从衣、食、住、行等方面，感受中华人民共和国成立以来的伟大成就。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.GQ.01",
  "stage": "义教",
  "segment": 2,
  "theme": "国情教育",
  "seq": 1,
  "line": 68,
  "quote": "知道我国的地理位置、领土面积、海陆疆域、行政区划，知道台湾是中国不可分割的一部分，祖国的领土神圣不可侵犯。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.GQ.02",
  "stage": "义教",
  "segment": 2,
  "theme": "国情教育",
  "seq": 2,
  "line": 69,
  "quote": "了解祖国的名山大川和名胜古迹，为生活在中国而自豪。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.GQ.03",
  "stage": "义教",
  "segment": 2,
  "theme": "国情教育",
  "seq": 3,
  "line": 70,
  "quote": "感受身边的变化，了解家乡的发展，对祖国未来充满信心。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:2.GQ.04",
  "stage": "义教",
  "segment": 2,
  "theme": "国情教育",
  "seq": 4,
  "line": 71,
  "quote": "领悟“绿水青山就是金山银山”的道理，懂得人与自然和谐共生的重要性，初步树立生态文明意识。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.DD.01",
  "stage": "义教",
  "segment": 3,
  "theme": "道德教育",
  "seq": 1,
  "line": 72,
  "quote": "懂得做人要诚信、自尊、自爱、自强的道理。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.DD.02",
  "stage": "义教",
  "segment": 3,
  "theme": "道德教育",
  "seq": 2,
  "line": 73,
  "quote": "愿意反思自己的生活和行为，学会理性思考，作出正确的判断与选择。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.DD.03",
  "stage": "义教",
  "segment": 3,
  "theme": "道德教育",
  "seq": 3,
  "line": 74,
  "quote": "理解平等待人的意义，懂得谦让、友善和宽容，学会尊重、同情、关心和感恩，能够相互帮助，具有团结互助精神。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.DD.04",
  "stage": "义教",
  "segment": 3,
  "theme": "道德教育",
  "seq": 4,
  "line": 75,
  "quote": "体贴父母长辈，能够与他们进行良好的沟通，主动参与力所能及的家务劳动，感受劳动的意义，为父母分忧，懂得感恩。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.DD.05",
  "stage": "义教",
  "segment": 3,
  "theme": "道德教育",
  "seq": 5,
  "line": 76,
  "quote": "关心集体，在集体中承担相应的责任，具有集体意识和团队精神。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.DD.06",
  "stage": "义教",
  "segment": 3,
  "theme": "道德教育",
  "seq": 6,
  "line": 77,
  "quote": "了解和感受社会生活，主动参与力所能及的服务性劳动，做一个热爱生活、乐于奉献的人，积极服务社会，增强社会责任感。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.DD.07",
  "stage": "义教",
  "segment": 3,
  "theme": "道德教育",
  "seq": 7,
  "line": 78,
  "quote": "助人为乐，爱护公物，遵守社会交往、公共场所中的文明规范。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.SM.01",
  "stage": "义教",
  "segment": 3,
  "theme": "生命安全与健康教育",
  "seq": 1,
  "line": 79,
  "quote": "珍爱生命，远离烟酒，拒绝毒品，形成良好的生活方式和健康的生活习惯。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.SM.02",
  "stage": "义教",
  "segment": 3,
  "theme": "生命安全与健康教育",
  "seq": 2,
  "line": 80,
  "quote": "了解和识别性侵害、欺凌行为的危害，学会自我保护和寻求帮助，预防和远离性侵害、欺凌和拐骗。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.SM.03",
  "stage": "义教",
  "segment": 3,
  "theme": "生命安全与健康教育",
  "seq": 3,
  "line": 81,
  "quote": "了解公共卫生事件、社会管控措施和个人行为要求，初步树立社会安全意识和遵守公共卫生规则的意识。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.SM.04",
  "stage": "义教",
  "segment": 3,
  "theme": "生命安全与健康教育",
  "seq": 4,
  "line": 82,
  "quote": "了解突发公共卫生事件、地震、洪水等抗疫抗灾的伟大实践，认识“把人民群众的生命安全与身体健康放在第一位”的价值理念。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.FZ.01",
  "stage": "义教",
  "segment": 3,
  "theme": "法治教育",
  "seq": 1,
  "line": 83,
  "quote": "初步认识法律的概念及特征，感受法律对个人生活和公共生活的重要性，养成自觉守法、遇事找法、解决问题靠法的思维习惯和行为方式。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.FZ.02",
  "stage": "义教",
  "segment": 3,
  "theme": "法治教育",
  "seq": 2,
  "line": 84,
  "quote": "初步了解宪法的主要内容，知道宪法是国家根本法、社会主义制度是中华人民共和国的根本制度。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.FZ.03",
  "stage": "义教",
  "segment": 3,
  "theme": "法治教育",
  "seq": 3,
  "line": 85,
  "quote": "认识公民的内涵，了解公民的权利和义务，树立法律面前人人平等的观念。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.FZ.04",
  "stage": "义教",
  "segment": 3,
  "theme": "法治教育",
  "seq": 4,
  "line": 86,
  "quote": "认识民主、自由、平等、公正对社会生活的意义，初步具备民主参与、责任担当意识。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.FZ.05",
  "stage": "义教",
  "segment": 3,
  "theme": "法治教育",
  "seq": 5,
  "line": 87,
  "quote": "了解消费者权益保护、食品安全等法律常识，初步学会运用法律维护自己的合法权益。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.FZ.06",
  "stage": "义教",
  "segment": 3,
  "theme": "法治教育",
  "seq": 6,
  "line": 88,
  "quote": "了解未成年人的权利，增强自我保护的意识，学会自我保护。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.FZ.07",
  "stage": "义教",
  "segment": 3,
  "theme": "法治教育",
  "seq": 7,
  "line": 89,
  "quote": "认识未成年人不良行为的危害，知道违法要承担法律责任，自觉抵制不良行为，主动预防未成年人犯罪。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.FZ.08",
  "stage": "义教",
  "segment": 3,
  "theme": "法治教育",
  "seq": 8,
  "line": 90,
  "quote": "初步了解危害国家安全特别是社会安全的行为及防范措施。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.CT.01",
  "stage": "义教",
  "segment": 3,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 1,
  "line": 91,
  "quote": "了解中华文化的悠久历史和博大精深，体会中华优秀传统文化的精髓。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.CT.02",
  "stage": "义教",
  "segment": 3,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 2,
  "line": 92,
  "quote": "了解中华民族对人类文明的贡献，为中华民族创造的文明成就感到自豪，坚定文化自信。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.CT.03",
  "stage": "义教",
  "segment": 3,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 3,
  "line": 93,
  "quote": "了解不同文明之间交流互鉴的重要性，尊重不同文化的差异性，以包容的态度看待不同文明之间的交流对话。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.CT.04",
  "stage": "义教",
  "segment": 3,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 4,
  "line": 94,
  "quote": "了解人民军队在不同时期称谓的演变，了解人民军队的革命历史、英雄人物，知道人民军队始终是中国人民的守护者、国家安全的维护者、世界和平的捍卫者，感受人民军队英勇顽强、不怕牺牲的革命精神。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.CT.05",
  "stage": "义教",
  "segment": 3,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 5,
  "line": 95,
  "quote": "了解中国共产党的成立以及中国共产党带领中国人民取得革命胜利的历史，初步了解马克思主义中国化时代化的发展进程，知道全心全意为人民服务是中国共产党的根本宗旨，激发热爱中国共产党的情感。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.CT.06",
  "stage": "义教",
  "segment": 3,
  "theme": "中华优秀传统文化与革命传统教育",
  "seq": 6,
  "line": 96,
  "quote": "初步了解中华人民共和国成立实现了从几千年封建专制政治向人民民主的伟大飞跃，知道中国人民从此站起来了。明确只有社会主义才能救中国，只有社会主义才能发展中国。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.GQ.01",
  "stage": "义教",
  "segment": 3,
  "theme": "国情教育",
  "seq": 1,
  "line": 97,
  "quote": "知道马克思主义在意识形态领域指导地位的根本制度，初步树立共产主义远大理想和中国特色社会主义共同理想。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.GQ.02",
  "stage": "义教",
  "segment": 3,
  "theme": "国情教育",
  "seq": 2,
  "line": 98,
  "quote": "初步理解社会主义核心价值观的内涵，并在日常学习和生活中广泛践行社会主义核心价值观。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.GQ.03",
  "stage": "义教",
  "segment": 3,
  "theme": "国情教育",
  "seq": 3,
  "line": 99,
  "quote": "了解改革开放以来我国所取得的伟大成就，明确中国特色社会主义道路是指引中国发展繁荣的正确道路，理解只有走中国特色社会主义道路才能够实现中华民族伟大复兴，初步了解中国式现代化的内涵与特征。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.GQ.04",
  "stage": "义教",
  "segment": 3,
  "theme": "国情教育",
  "seq": 4,
  "line": 100,
  "quote": "知道中国特色社会主义进入新时代，初步了解习近平新时代中国特色社会主义思想，明确习近平新时代中国特色社会主义思想的指导地位。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:3.GQ.05",
  "stage": "义教",
  "segment": 3,
  "theme": "国情教育",
  "seq": 5,
  "line": 101,
  "quote": "初步感受百年未有之大变局和世界发展大势，能够举例说明构建人类命运共同体的意义。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.SM.01",
  "stage": "义教",
  "segment": 4,
  "theme": "生命安全与健康教育",
  "seq": 1,
  "line": 102,
  "quote": "了解青春期的生理和心理变化，体会青春期的美好，学会克服青春期烦恼；掌握青春期性心理知识，正确对待两性关系；提高预防性骚扰和性侵害的能力。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.SM.02",
  "stage": "义教",
  "segment": 4,
  "theme": "生命安全与健康教育",
  "seq": 2,
  "line": 103,
  "quote": "客观认识和对待自己，形成正确的自我认同，提高自我管理能力；理解不同的社会角色，形成亲社会的行为；能正确认识和处理自己与同学、朋友的关系，个人和集体的关系，在团队活动中增强合作精神。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.SM.03",
  "stage": "义教",
  "segment": 4,
  "theme": "生命安全与健康教育",
  "seq": 3,
  "line": 104,
  "quote": "正确认识顺境和逆境的关系，学会情绪调控，能够正确看待生活中的挫折，具备迎接挑战的能力。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.SM.04",
  "stage": "义教",
  "segment": 4,
  "theme": "生命安全与健康教育",
  "seq": 4,
  "line": 105,
  "quote": "树立正确的人生观和价值观，尊重和敬畏生命，热爱生活，追求生命高度，成就幸福人生。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.SM.05",
  "stage": "义教",
  "segment": 4,
  "theme": "生命安全与健康教育",
  "seq": 5,
  "line": 106,
  "quote": "遵守基本的社交礼仪，恪守诚信，理性维护社会公德，维护公共秩序，做文明的社会成员。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.FZ.01",
  "stage": "义教",
  "segment": 4,
  "theme": "法治教育",
  "seq": 1,
  "line": 107,
  "quote": "了解习近平法治思想，理解坚持中国特色社会主义法治道路就要坚持党的领导、坚持以人民为中心。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.FZ.02",
  "stage": "义教",
  "segment": 4,
  "theme": "法治教育",
  "seq": 2,
  "line": 108,
  "quote": "了解宪法基本知识，明确宪法的地位与作用，树立宪法法律至上观念。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.FZ.03",
  "stage": "义教",
  "segment": 4,
  "theme": "法治教育",
  "seq": 3,
  "line": 109,
  "quote": "懂得公民的基本权利和义务，正确行使公民权利，自觉履行公民义务。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.FZ.04",
  "stage": "义教",
  "segment": 4,
  "theme": "法治教育",
  "seq": 4,
  "line": 110,
  "quote": "初步认识法治的内涵，理解法治是中国式现代化的重要保障。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.FZ.05",
  "stage": "义教",
  "segment": 4,
  "theme": "法治教育",
  "seq": 5,
  "line": 111,
  "quote": "认识国家统一是实现中华民族伟大复兴的历史前提和基本保证，理解“和平统一、一国两制”的重要意义，自觉维护国家统一。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.FZ.06",
  "stage": "义教",
  "segment": 4,
  "theme": "法治教育",
  "seq": 6,
  "line": 112,
  "quote": "了解人民代表大会制度是我国的根本政治制度，理解全过程人民民主的制度优势。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.FZ.07",
  "stage": "义教",
  "segment": 4,
  "theme": "法治教育",
  "seq": 7,
  "line": 113,
  "quote": "认识协商民主是实践全过程人民民主的重要形式，了解中国共产党领导的多党合作和政治协商制度。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.FZ.08",
  "stage": "义教",
  "segment": 4,
  "theme": "法治教育",
  "seq": 8,
  "line": 114,
  "quote": "了解民族区域自治制度对维护和发展平等团结互助和谐的社会主义民族关系的意义。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.FZ.09",
  "stage": "义教",
  "segment": 4,
  "theme": "法治教育",
  "seq": 9,
  "line": 115,
  "quote": "认识基层民主制度对保障人民知情权、参与权、表达权、监督权的作用。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.FZ.10",
  "stage": "义教",
  "segment": 4,
  "theme": "法治教育",
  "seq": 10,
  "line": 116,
  "quote": "认识主要国家机关，理解权力是由人民授予的，行使权力必须受法律的约束。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.FZ.11",
  "stage": "义教",
  "segment": 4,
  "theme": "法治教育",
  "seq": 11,
  "line": 117,
  "quote": "认识民法典对保护人身权、财产权的意义。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.FZ.12",
  "stage": "义教",
  "segment": 4,
  "theme": "法治教育",
  "seq": 12,
  "line": 118,
  "quote": "认识犯罪的基本概念，了解刑罚的主要类型；认识未成年人违法犯罪行为的危害，培育和提高自我保护的意识和能力，自觉抵制校园欺凌和违法犯罪行为。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.FZ.13",
  "stage": "义教",
  "segment": 4,
  "theme": "法治教育",
  "seq": 13,
  "line": 119,
  "quote": "辨别媒体中的不良信息，了解网络环境中如何保护未成年人隐私等合法权益。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.FZ.14",
  "stage": "义教",
  "segment": 4,
  "theme": "法治教育",
  "seq": 14,
  "line": 120,
  "quote": "了解环境保护的法律规定，树立生态文明观念，促进人与自然和谐共生。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.FZ.15",
  "stage": "义教",
  "segment": 4,
  "theme": "法治教育",
  "seq": 15,
  "line": 121,
  "quote": "认识国家安全的内涵，树立国家利益至上的观念，理解国家安全是中国式现代化行稳致远的重要基础，了解国家新安全格局，知道维护国家安全是每个公民的义务，自觉维护国家安全。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.FZ.16",
  "stage": "义教",
  "segment": 4,
  "theme": "法治教育",
  "seq": 16,
  "line": 122,
  "quote": "了解主要国际组织，理解维护以联合国为核心的国际体系的意义。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.CT.01",
  "stage": "义教",
  "segment": 4,
  "theme": "中华优秀传统文化教育",
  "seq": 1,
  "line": 123,
  "quote": "弘扬中华优秀传统文化讲仁爱、重民本、守诚信、崇正义、尚和合、求大同的核心理念。了解中华文明具有突出的连续性、创新性、统一性、包容性、和平性。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.CT.02",
  "stage": "义教",
  "segment": 4,
  "theme": "中华优秀传统文化教育",
  "seq": 2,
  "line": 124,
  "quote": "理解中华民族孝悌忠信、礼义廉耻的荣辱观念，崇德向善、见贤思齐的社会风尚。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.CT.03",
  "stage": "义教",
  "segment": 4,
  "theme": "中华优秀传统文化教育",
  "seq": 3,
  "line": 125,
  "quote": "践行中华民族自强不息、敬业乐群、脚踏实地、实事求是的思想。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.CT.04",
  "stage": "义教",
  "segment": 4,
  "theme": "中华优秀传统文化教育",
  "seq": 4,
  "line": 126,
  "quote": "了解中华优秀传统文化修齐治平的理想追求，锤炼高尚人格。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.CT.05",
  "stage": "义教",
  "segment": 4,
  "theme": "中华优秀传统文化教育",
  "seq": 5,
  "line": 127,
  "quote": "感悟天下兴亡、匹夫有责的担当意识，厚植爱国主义情怀。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.CT.06",
  "stage": "义教",
  "segment": 4,
  "theme": "中华优秀传统文化教育",
  "seq": 6,
  "line": 128,
  "quote": "明确新时代建设社会主义文化强国新的文化使命，坚定文化自信、担当使命、奋发有为，努力学习，致力提升国家文化软实力和中华文化影响力。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.GC.01",
  "stage": "义教",
  "segment": 4,
  "theme": "革命传统教育",
  "seq": 1,
  "line": 129,
  "quote": "了解中国产生了共产党，这是开天辟地的大事变，理解伟大建党精神的内涵，领悟伟大建党精神是中国共产党的精神之源。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.GC.02",
  "stage": "义教",
  "segment": 4,
  "theme": "革命传统教育",
  "seq": 2,
  "line": 130,
  "quote": "了解中国共产党领导人民浴血奋战、百折不挠，创造了新民主主义革命的伟大成就，实现了从几千年封建专制政治向人民民主的伟大飞跃，理解中国人民从此站起来了，中国发展从此开启了新纪元。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.GC.03",
  "stage": "义教",
  "segment": 4,
  "theme": "革命传统教育",
  "seq": 3,
  "line": 131,
  "quote": "了解中国共产党领导人民自力更生、发愤图强，创造了社会主义革命和建设的伟大成就，实现了一穷二白、人口众多的东方大国大步迈进社会主义社会的伟大飞跃，理解只有社会主义才能救中国，只有社会主义才能发展中国。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.GC.04",
  "stage": "义教",
  "segment": 4,
  "theme": "革命传统教育",
  "seq": 4,
  "line": 132,
  "quote": "了解中国共产党领导人民解放思想、锐意进取，创造了改革开放和社会主义现代化建设的伟大成就，实现了人民生活从温饱不足到总体小康、奔向全面小康的历史性跨越，推进了中华民族从站起来到富起来的伟大飞跃，理解中国特色社会主义道路是指引中国发展繁荣的正确道路。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.GC.05",
  "stage": "义教",
  "segment": 4,
  "theme": "革命传统教育",
  "seq": 5,
  "line": 133,
  "quote": "了解中国共产党领导人民自信自强、守正创新，创造了新时代中国特色社会主义的伟大成就，中华民族迎来了从富起来到强起来的伟大飞跃，理解确立习近平新时代中国特色社会主义思想的指导地位，对新时代党和国家事业发展、对推进中华民族伟大复兴历史进程具有决定性意义。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.GQ.01",
  "stage": "义教",
  "segment": 4,
  "theme": "国情教育",
  "seq": 1,
  "line": 134,
  "quote": "了解中国特色社会主义新时代是我国发展新的历史方位，中国社会的主要矛盾发生了新变化，理解中国发展的历史方位。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.GQ.02",
  "stage": "义教",
  "segment": 4,
  "theme": "国情教育",
  "seq": 2,
  "line": 135,
  "quote": "了解世界正处于百年未有之大变局，了解全人类共同价值的内涵，领悟构建人类命运共同体的意义。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.GQ.03",
  "stage": "义教",
  "segment": 4,
  "theme": "国情教育",
  "seq": 3,
  "line": 136,
  "quote": "了解我国统筹国内国际两个大局，统筹推进“五位一体”总体布局，协调推进“四个全面”战略布局，认识我国推进中国式现代化建设的战略部署。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "ddf-2022:4.GQ.04",
  "stage": "义教",
  "segment": 4,
  "theme": "国情教育",
  "seq": 4,
  "line": 137,
  "quote": "以实现中华民族伟大复兴为己任，树立“劳动光荣、创造伟大”的观念，进行合理的生涯规划，坚定为实现远大理想而奋斗的信念。",
  "source": "ddfz-2022-content.txt"
 },
 {
  "id": "zz-2017:G.1.0101",
  "stage": "高中",
  "segment": 1,
  "theme": "人类社会发展的进程与趋势",
  "seq": [
   1,
   1
  ],
  "line": 4,
  "quote": "描述不同社会形态的本质特征；解释人类社会发展的一般过程，阐明社会发展的历史进程取决于社会基本矛盾的运动。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.1.0102",
  "stage": "高中",
  "segment": 1,
  "theme": "人类社会发展的进程与趋势",
  "seq": [
   1,
   2
  ],
  "line": 5,
  "quote": "分析资本主义社会的历史地位，概述社会主义从空想到科学、从理论到现实的历史轨迹，阐明人类社会发展的趋势。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.1.0201",
  "stage": "高中",
  "segment": 1,
  "theme": "中国特色社会主义的探索、开创与发展",
  "seq": [
   2,
   1
  ],
  "line": 6,
  "quote": "阐述新民主主义革命的性质和特点，理解新中国确立社会主义制度的历史必然性。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.1.0202",
  "stage": "高中",
  "segment": 1,
  "theme": "中国特色社会主义的探索、开创与发展",
  "seq": [
   2,
   2
  ],
  "line": 7,
  "quote": "阐述社会主义革命和建设时期，党团结带领全国人民实现从新民主主义到社会主义的转变，进行社会主义革命，推进社会主义建设，为实现中华民族伟大复兴奠定根本政治前提和制度基础；理解只有社会主义才能救中国，只有社会主义才能发展中国。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.1.0203",
  "stage": "高中",
  "segment": 1,
  "theme": "中国特色社会主义的探索、开创与发展",
  "seq": [
   2,
   3
  ],
  "line": 8,
  "quote": "阐述在改革开放和社会主义现代化建设新时期，党团结带领全国人民继续探索中国建设社会主义的正确道路，解放和发展社会生产力，使人民摆脱贫困、尽快富裕起来，为实现中华民族伟大复兴提供充满新的活力的体制保证和快速发展的物质条件。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.1.0204",
  "stage": "高中",
  "segment": 1,
  "theme": "中国特色社会主义的探索、开创与发展",
  "seq": [
   2,
   4
  ],
  "line": 9,
  "quote": "阐述党的十八大以来，以习近平同志为主要代表的中国共产党人，坚持把马克思主义基本原理同中国具体实际相结合、同中华优秀传统文化相结合，创立了习近平新时代中国特色社会主义思想，推动党和国家事业取得历史性成就、发生历史性变革；理解这一思想是以中国式现代化全面推进强国建设、民族复兴伟业的行动指南。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.2.0101",
  "stage": "高中",
  "segment": 2,
  "theme": "经济制度与经济体制",
  "seq": [
   1,
   1
  ],
  "line": 10,
  "quote": "理解公有制为主体、多种所有制经济共同发展，按劳分配为主体、多种分配方式并存，社会主义市场经济体制等社会主义基本经济制度，既体现了社会主义制度优越性，又同我国社会主义初级阶段社会生产力发展水平相适应，是党和人民的伟大创造。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.2.0102",
  "stage": "高中",
  "segment": 2,
  "theme": "经济制度与经济体制",
  "seq": [
   1,
   2
  ],
  "line": 11,
  "quote": "了解各种所有制经济的地位与作用，阐释公有制经济与非公有制经济相互促进、共同发展，明确坚持毫不动摇巩固和发展公有制经济，毫不动摇鼓励、支持、引导非公有制经济发展。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.2.0103",
  "stage": "高中",
  "segment": 2,
  "theme": "经济制度与经济体制",
  "seq": [
   1,
   3
  ],
  "line": 12,
  "quote": "阐述构建高水平社会主义市场经济体制的意义，辨析经济运行中政府与市场的关系，解析宏观调控的目标与手段。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.2.0201",
  "stage": "高中",
  "segment": 2,
  "theme": "经济发展与社会进步",
  "seq": [
   2,
   1
  ],
  "line": 13,
  "quote": "阐明以人民为中心的发展思想，阐释创新、协调、绿色、开放、共享的新发展理念，阐述加快构建新发展格局、因地制宜发展新质生产力、着力推动高质量发展的意义和要求，解释经济发展方式的转变和供给侧结构性改革，评析经济发展中践行社会责任的实例。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.2.0202",
  "stage": "高中",
  "segment": 2,
  "theme": "经济发展与社会进步",
  "seq": [
   2,
   2
  ],
  "line": 14,
  "quote": "了解我国个人收入的方式与合法途径，解释个人收入分配政策的完善；评析实现共同富裕、促进社会公平正义的收入分配与社会保障政策，列举完善社会保障体系的措施。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.2.0203",
  "stage": "高中",
  "segment": 2,
  "theme": "经济发展与社会进步",
  "seq": [
   2,
   3
  ],
  "line": 15,
  "quote": "阐明劳动对社会发展和进步的意义，弘扬劳动精神，树立崇尚劳动、热爱劳动的观念。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.3.0101",
  "stage": "高中",
  "segment": 3,
  "theme": "中国共产党的领导",
  "seq": [
   1,
   1
  ],
  "line": 16,
  "quote": "引述宪法序言，说明没有中国共产党就没有新中国，阐明中国共产党成为执政党的必然性。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.3.0102",
  "stage": "高中",
  "segment": 3,
  "theme": "中国共产党的领导",
  "seq": [
   1,
   2
  ],
  "line": 17,
  "quote": "引述党章规定，明确党的性质、宗旨和指导思想。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.3.0103",
  "stage": "高中",
  "segment": 3,
  "theme": "中国共产党的领导",
  "seq": [
   1,
   3
  ],
  "line": 18,
  "quote": "理解坚持党的全面领导的意义，阐述坚持依法治国、依法执政、依法行政共同推进的道理。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.3.0201",
  "stage": "高中",
  "segment": 3,
  "theme": "人民当家作主",
  "seq": [
   2,
   1
  ],
  "line": 19,
  "quote": "列举宪法有关人民主体地位的规定，说明我国是人民民主专政的社会主义国家，人民代表大会制度是我国的根本政治制度。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.3.0202",
  "stage": "高中",
  "segment": 3,
  "theme": "人民当家作主",
  "seq": [
   2,
   2
  ],
  "line": 20,
  "quote": "阐明中国共产党领导的多党合作和政治协商制度是具有中国特色的基本政治制度。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.3.0203",
  "stage": "高中",
  "segment": 3,
  "theme": "人民当家作主",
  "seq": [
   2,
   3
  ],
  "line": 21,
  "quote": "阐述民族区域自治制度是符合我国国情的基本政治制度，铸牢中华民族共同体意识；解释公民享有宗教信仰自由的含义。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.3.0204",
  "stage": "高中",
  "segment": 3,
  "theme": "人民当家作主",
  "seq": [
   2,
   4
  ],
  "line": 22,
  "quote": "领悟基层群众自治制度是我国人民依法直接行使民主权利的基本政治制度。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.3.0301",
  "stage": "高中",
  "segment": 3,
  "theme": "依法治国",
  "seq": [
   3,
   1
  ],
  "line": 23,
  "quote": "简述我国法治建设的成就；明确全面推进依法治国的总目标是建设中国特色社会主义法治体系，建设社会主义法治国家。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.3.0302",
  "stage": "高中",
  "segment": 3,
  "theme": "依法治国",
  "seq": [
   3,
   2
  ],
  "line": 24,
  "quote": "搜集材料，阐述科学立法、严格执法、公正司法、全民守法的基本要求。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.3.0303",
  "stage": "高中",
  "segment": 3,
  "theme": "依法治国",
  "seq": [
   3,
   3
  ],
  "line": 25,
  "quote": "列举事例，阐明建设法治国家、法治政府、法治社会的意义。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.4.0101",
  "stage": "高中",
  "segment": 4,
  "theme": "探索世界与追求真理",
  "seq": [
   1,
   1
  ],
  "line": 26,
  "quote": "比较哲学思维与日常思维的异同；理解任何真正的哲学都是自己时代的精神上的精华，阐明马克思主义哲学是科学的世界观和方法论。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.4.0102",
  "stage": "高中",
  "segment": 4,
  "theme": "探索世界与追求真理",
  "seq": [
   1,
   2
  ],
  "line": 27,
  "quote": "说明思维和存在的关系问题，阐释世界的统一性在于它的物质性；表达无神论立场；表明坚持一切从实际出发、实事求是的态度。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.4.0103",
  "stage": "高中",
  "segment": 4,
  "theme": "探索世界与追求真理",
  "seq": [
   1,
   3
  ],
  "line": 28,
  "quote": "了解人的实践活动的特性和作用，理解社会生活的实践本质；阐明实践是认识的基础，是检验真理的唯一标准；阐述认识运动的辩证发展过程。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.4.0104",
  "stage": "高中",
  "segment": 4,
  "theme": "探索世界与追求真理",
  "seq": [
   1,
   4
  ],
  "line": 29,
  "quote": "坚持系统观念，理解世界是普遍联系、永恒运动的，领会全面地、发展地看问题的意义，学会运用矛盾分析法观察和处理问题。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.4.0201",
  "stage": "高中",
  "segment": 4,
  "theme": "认识社会与价值选择",
  "seq": [
   2,
   1
  ],
  "line": 30,
  "quote": "领悟社会存在决定社会意识，理解价值观的形成与时代和环境密切相关；解析价值观差异与冲突产生的社会根源，能够进行合理的价值判断和行为选择。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.4.0202",
  "stage": "高中",
  "segment": 4,
  "theme": "认识社会与价值选择",
  "seq": [
   2,
   2
  ],
  "line": 31,
  "quote": "理解价值观对人们行为的导向作用，探寻实现人生价值的条件和途径，践行社会主义核心价值观。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.4.0301",
  "stage": "高中",
  "segment": 4,
  "theme": "文化传承与文化创新",
  "seq": [
   3,
   1
  ],
  "line": 32,
  "quote": "坚持守正创新，理解坚守马克思主义这个魂脉、中华优秀传统文化这个根脉的重要性，了解中华文明的五个突出特性——连续性、创新性、统一性、包容性、和平性，领会对中华优秀传统文化进行创造性转化、创新性发展的重要意义，弘扬民族精神。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.4.0302",
  "stage": "高中",
  "segment": 4,
  "theme": "文化传承与文化创新",
  "seq": [
   3,
   2
  ],
  "line": 33,
  "quote": "坚持胸怀天下，弘扬全人类共同价值，了解我国坚持平等、互鉴、对话、包容文明观的意义，感悟世界文化的多样性，理解文化多样性的价值，明确文化交流互鉴的途径和意义。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.4.0303",
  "stage": "高中",
  "segment": 4,
  "theme": "文化传承与文化创新",
  "seq": [
   3,
   3
  ],
  "line": 34,
  "quote": "辨识各种文化现象，领悟优秀文化作品的影响力和感召力；明确建设社会主义文化强国的要求，展示中国特色社会主义文化自信。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.5.0101",
  "stage": "高中",
  "segment": 5,
  "theme": "各具特色的国家",
  "seq": [
   1,
   1
  ],
  "line": 35,
  "quote": "了解国体和政体的关系，揭示国家的本质，理解国家管理形式的多样性。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.5.0102",
  "stage": "高中",
  "segment": 5,
  "theme": "各具特色的国家",
  "seq": [
   1,
   2
  ],
  "line": 36,
  "quote": "解析国家的结构形式，理解维护国家统一、捍卫国家主权的意义。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.5.0103",
  "stage": "高中",
  "segment": 5,
  "theme": "各具特色的国家",
  "seq": [
   1,
   3
  ],
  "line": 37,
  "quote": "引用实例，比较不同国家的特点及发展状况，阐明我国的总体国家安全观。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.5.0201",
  "stage": "高中",
  "segment": 5,
  "theme": "世界多极化",
  "seq": [
   2,
   1
  ],
  "line": 38,
  "quote": "引用国家之间合作、竞争、冲突的实例，印证国家利益和国家实力是决定国际关系的主要因素。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.5.0202",
  "stage": "高中",
  "segment": 5,
  "theme": "世界多极化",
  "seq": [
   2,
   2
  ],
  "line": 39,
  "quote": "引述有关资料，全面阐述和平、发展、合作、共赢的历史潮流，描述当前世界之变、时代之变、历史之变正以前所未有的方式展开；解释我国独立自主的和平外交政策，阐述合作共赢的理念，认识促进世界和平与发展、推动构建人类命运共同体的意义。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.5.0203",
  "stage": "高中",
  "segment": 5,
  "theme": "世界多极化",
  "seq": [
   2,
   3
  ],
  "line": 40,
  "quote": "阐明霸权主义、强权政治的危害，了解共商共建共享的全球治理观，理解推动平等有序的世界多极化的意义。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.5.0301",
  "stage": "高中",
  "segment": 5,
  "theme": "经济全球化",
  "seq": [
   3,
   1
  ],
  "line": 41,
  "quote": "辨识国际经济中的比较优势，描述当代国际经济发展的基本特点和趋势。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.5.0302",
  "stage": "高中",
  "segment": 5,
  "theme": "经济全球化",
  "seq": [
   3,
   2
  ],
  "line": 42,
  "quote": "分析经济全球化的机遇和挑战，坚持正确义利观，阐释推动建设开放型世界经济的意义。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.5.0303",
  "stage": "高中",
  "segment": 5,
  "theme": "经济全球化",
  "seq": [
   3,
   3
  ],
  "line": 43,
  "quote": "引用实例，说明中国如何推动经济全球化朝着更加开放、包容、普惠、平衡、共赢的方向发展。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.5.0401",
  "stage": "高中",
  "segment": 5,
  "theme": "国际组织",
  "seq": [
   4,
   1
  ],
  "line": 44,
  "quote": "阐释联合国宪章倡导的国际关系基本准则，评析联合国在国际事务中发挥的作用；分析世界贸易组织、世界银行、国际货币基金组织、亚洲基础设施投资银行等在国际经济事务中发挥的作用。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.5.0402",
  "stage": "高中",
  "segment": 5,
  "theme": "国际组织",
  "seq": [
   4,
   2
  ],
  "line": 45,
  "quote": "识别主要的区域性国际组织，评价区域性国际组织在国际事务中发挥的作用。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.6.0101",
  "stage": "高中",
  "segment": 6,
  "theme": "民事权利与义务",
  "seq": [
   1,
   1
  ],
  "line": 46,
  "quote": "了解我国民法典确立的民法基本原则，识别民事主体的民事权利和民事责任，明确民事权利与义务的关系。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.6.0102",
  "stage": "高中",
  "segment": 6,
  "theme": "民事权利与义务",
  "seq": [
   1,
   2
  ],
  "line": 47,
  "quote": "了解物权的主要类型，懂得维护物权的途径；理解知识产权保护的意义。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.6.0103",
  "stage": "高中",
  "segment": 6,
  "theme": "民事权利与义务",
  "seq": [
   1,
   3
  ],
  "line": 48,
  "quote": "简述合同的价值，理解合同的主要内容和违约责任，了解合同订立的程序和解决合同纠纷的途径。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.6.0104",
  "stage": "高中",
  "segment": 6,
  "theme": "民事权利与义务",
  "seq": [
   1,
   4
  ],
  "line": 49,
  "quote": "引用实例说明侵权责任的内容，树立依法承担责任的观念。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.6.0201",
  "stage": "高中",
  "segment": 6,
  "theme": "家庭与婚姻",
  "seq": [
   2,
   1
  ],
  "line": 50,
  "quote": "了解抚养、扶养、赡养等民事关系，培育家庭责任意识。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.6.0202",
  "stage": "高中",
  "segment": 6,
  "theme": "家庭与婚姻",
  "seq": [
   2,
   2
  ],
  "line": 51,
  "quote": "理解婚姻法律关系，树立正确的婚姻家庭观念。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.6.0301",
  "stage": "高中",
  "segment": 6,
  "theme": "就业与创业",
  "seq": [
   3,
   1
  ],
  "line": 52,
  "quote": "理解劳动者的权利和义务，了解劳动合同的主要内容和劳动者依法维权的途径、方式。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.6.0302",
  "stage": "高中",
  "segment": 6,
  "theme": "就业与创业",
  "seq": [
   3,
   2
  ],
  "line": 53,
  "quote": "列举与创业有关的企业登记、企业信息公示等基本法律规定，评述市场竞争的基本规则，说明依法经营的必要性。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.6.0401",
  "stage": "高中",
  "segment": 6,
  "theme": "社会争议解决",
  "seq": [
   4,
   1
  ],
  "line": 54,
  "quote": "识别人民调解、行政调解等不同的调解方式，明确调解制度的特点和程序。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.6.0402",
  "stage": "高中",
  "segment": 6,
  "theme": "社会争议解决",
  "seq": [
   4,
   2
  ],
  "line": 55,
  "quote": "列举劳动争议仲裁、商事仲裁等仲裁形式，明确仲裁制度的特点和程序。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.6.0403",
  "stage": "高中",
  "segment": 6,
  "theme": "社会争议解决",
  "seq": [
   4,
   3
  ],
  "line": 56,
  "quote": "了解民事诉讼、刑事诉讼、行政诉讼的特点，说明不同诉讼中的举证规则，树立证据意识。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.6.0404",
  "stage": "高中",
  "segment": 6,
  "theme": "社会争议解决",
  "seq": [
   4,
   4
  ],
  "line": 57,
  "quote": "概述公民的诉讼权利，熟悉公民获得法律援助的渠道。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.7.0101",
  "stage": "高中",
  "segment": 7,
  "theme": "学会科学思维",
  "seq": [
   1,
   1
  ],
  "line": 58,
  "quote": "描述常见的思维活动，体会思维是人所特有的属性，了解思维的基本形态和特征；懂得正确思维的基本条件。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.7.0102",
  "stage": "高中",
  "segment": 7,
  "theme": "学会科学思维",
  "seq": [
   1,
   2
  ],
  "line": 59,
  "quote": "区分抽象思维和形象思维；掌握科学思维的特点，体悟学会科学思维的意义。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.7.0201",
  "stage": "高中",
  "segment": 7,
  "theme": "遵循逻辑思维要求",
  "seq": [
   2,
   1
  ],
  "line": 60,
  "quote": "知道概念是反映事物本质属性的思维形式；理解任何概念都是内涵和外延的统一。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.7.0202",
  "stage": "高中",
  "segment": 7,
  "theme": "遵循逻辑思维要求",
  "seq": [
   2,
   2
  ],
  "line": 61,
  "quote": "知道判断的基本特征；了解形成恰当判断的条件；学会正确运用判断；结合具体的判断活动，区分判断的不同类型。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.7.0203",
  "stage": "高中",
  "segment": 7,
  "theme": "遵循逻辑思维要求",
  "seq": [
   2,
   3
  ],
  "line": 62,
  "quote": "了解推理的类型；掌握演绎推理的基本方法；学会归纳推理、类比推理；评析常见的推理错误。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.7.0204",
  "stage": "高中",
  "segment": 7,
  "theme": "遵循逻辑思维要求",
  "seq": [
   2,
   4
  ],
  "line": 63,
  "quote": "辨析常见的逻辑错误，掌握形式逻辑的三个基本规律。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.7.0301",
  "stage": "高中",
  "segment": 7,
  "theme": "运用辩证思维方法",
  "seq": [
   3,
   1
  ],
  "line": 64,
  "quote": "结合对复杂事物的把握，体会辩证思维的特征；理解分析与综合的辩证关系。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.7.0302",
  "stage": "高中",
  "segment": 7,
  "theme": "运用辩证思维方法",
  "seq": [
   3,
   2
  ],
  "line": 65,
  "quote": "联系事物发展过程中的渐进性和飞跃性，懂得事物的发展过程是量变与质变的统一；理解质量互变规律；把握适度原则。",
  "source": "zz-2017-content.txt"
 },
 {
  "id": "zz-2017:G.7.0303",
  "stage": "高中",
  "segment": 7,
  "theme": "运用辩证思维方法",
  "seq": [
   3,
   3
  ],
  "line": 66,
  "quote": "辨析简单肯定一切或否定一切的危害，了解辩证否定观的实质，体会认识不断深化的历程。",
  "source": "zz-2017-content.txt"
 },
 {
